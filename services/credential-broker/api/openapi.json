{
  "openapi": "3.1.0",
  "info": {
    "title": "Hermes Credential Broker",
    "version": "0.1.0",
    "description": "Reviewed credential contracts, owner-bound forms, replaceable providers, grants and isolated runtime delivery. No canonical secret-store requirement."
  },
  "servers": [
    {
      "url": "https://credentials.example.com:8443"
    }
  ],
