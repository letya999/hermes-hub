{
  "id": "mtls-files",
  "revision": 1,
  "title": "mTLS: certificate and key",
  "storage": "local",
  "fields": [
    {
      "id": "certificate",
      "label": "PEM certificate",
      "kind": "pem",
      "required": true,
      "max_bytes": 16384,
      "label_i18n": {
        "ru": "Сертификат PEM",
        "kk": "PEM сертификаты",
        "es": "Certificado PEM"
      }
    },
    {
      "id": "private_key",
      "label": "PEM private key",
      "kind": "pem",
      "required": true,
      "max_bytes": 16384,
      "label_i18n": {
        "ru": "Закрытый ключ PEM",
        "kk": "PEM жеке кілті",
        "es": "Clave privada PEM"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "file",
      "field": "certificate",
      "target": "/run/mcp-secrets/client.crt"
    },
    {
      "type": "file",
      "field": "private_key",
      "target": "/run/mcp-secrets/client.key"
    }
  ],
  "title_i18n": {
    "ru": "mTLS: сертификат и ключ",
    "kk": "mTLS: сертификат және кілт",
    "es": "mTLS: certificado y clave"
  }
}
