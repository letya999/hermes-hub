{
  "id": "notion-token",
  "revision": 1,
  "title": "Notion: integration token",
  "storage": "local",
  "fields": [
    {
      "id": "token",
      "label": "Notion integration token",
      "kind": "secret",
      "required": true,
      "max_bytes": 4096,
      "label_i18n": {
        "ru": "Токен интеграции Notion",
        "kk": "Notion интеграциясының токені",
        "es": "Token de integración de Notion"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "env",
      "field": "token",
      "target": "NOTION_TOKEN"
    }
  ],
  "title_i18n": {
    "ru": "Notion: токен интеграции",
    "kk": "Notion: интеграция токені",
    "es": "Notion: token de integración"
  }
}
