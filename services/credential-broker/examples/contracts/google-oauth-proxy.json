{
  "id": "google-oauth-proxy",
  "revision": 1,
  "title": "Google Calendar: authorization in Broker",
  "storage": "local",
  "fields": [],
  "allow_shared": true,
  "oauth_provider": "google",
  "routes": [
    {
      "id": "calendar",
      "base_url": "https://www.googleapis.com",
      "path_prefixes": [
        "/calendar/v3"
      ],
      "methods": [
        "GET"
      ],
      "auth": "oauth2"
    }
  ],
  "title_i18n": {
    "ru": "Google Calendar: авторизация в Broker",
    "kk": "Google Calendar: Broker-дегі авторизация",
    "es": "Google Calendar: autorización en Broker"
  }
}
