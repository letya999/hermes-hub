{
  "id": "ssh-key",
  "revision": 1,
  "title": "SSH private key (+ optional certificate)",
  "storage": "local",
  "fields": [
    {
      "id": "private_key",
      "label": "OpenSSH/PEM private key",
      "kind": "secret",
      "required": true,
      "max_bytes": 16384,
      "label_i18n": {
        "ru": "Закрытый ключ OpenSSH/PEM",
        "kk": "OpenSSH/PEM жеке кілті",
        "es": "Clave privada OpenSSH/PEM"
      }
    },
    {
      "id": "certificate",
      "label": "OpenSSH user certificate (optional)",
      "kind": "string",
      "required": false,
      "max_bytes": 16384,
      "label_i18n": {
        "ru": "Сертификат пользователя OpenSSH (необязательно)",
        "kk": "OpenSSH пайдаланушы сертификаты (міндетті емес)",
        "es": "Certificado de usuario OpenSSH (opcional)"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "env",
      "field": "private_key",
      "target": "SSH_PRIVATE_KEY"
    },
    {
      "type": "env",
      "field": "certificate",
      "target": "SSH_CERTIFICATE"
    }
  ],
  "title_i18n": {
    "ru": "Закрытый ключ SSH (+ необязательный сертификат)",
    "kk": "SSH жеке кілті (+ міндетті емес сертификат)",
    "es": "Clave privada SSH (+ certificado opcional)"
  }
}
