{
  "id": "github-api-proxy",
  "revision": 1,
  "title": "GitHub API: limited proxy",
  "storage": "local",
  "fields": [
    {
      "id": "token",
      "label": "GitHub token",
      "kind": "secret",
      "required": true,
      "max_bytes": 4096,
      "label_i18n": {
        "ru": "Токен GitHub",
        "kk": "GitHub токені",
        "es": "Token de GitHub"
      }
    }
  ],
  "allow_shared": true,
  "routes": [
    {
      "id": "github",
      "base_url": "https://api.github.com",
      "path_prefixes": [
        "/user",
        "/repos"
      ],
      "methods": [
        "GET"
      ],
      "auth": "bearer",
      "field": "token",
      "static_headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      }
    }
  ],
  "title_i18n": {
    "ru": "GitHub API: ограниченный proxy",
    "kk": "GitHub API: шектеулі proxy",
    "es": "API de GitHub: proxy limitado"
  }
}
