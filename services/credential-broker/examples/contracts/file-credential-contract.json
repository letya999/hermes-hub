{
  "id": "service-account-file",
  "revision": 1,
  "title": "Service account: JSON file",
  "storage": "local",
  "fields": [
    {
      "id": "credentials",
      "label": "JSON service account",
      "kind": "json",
      "required": true,
      "max_bytes": 65536,
      "label_i18n": {
        "ru": "JSON сервисного аккаунта",
        "kk": "Сервис аккаунтының JSON-ы",
        "es": "JSON de la cuenta de servicio"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "file",
      "field": "credentials",
      "target": "/run/mcp-secrets/service-account.json",
      "env_name": "GOOGLE_APPLICATION_CREDENTIALS"
    }
  ],
  "title_i18n": {
    "ru": "Сервисный аккаунт: JSON-файл",
    "kk": "Сервис аккаунты: JSON файлы",
    "es": "Cuenta de servicio: archivo JSON"
  }
}
