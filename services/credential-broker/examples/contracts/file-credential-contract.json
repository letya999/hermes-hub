{
  "id": "service-account-file",
  "revision": 1,
  "title": "Service account: JSON-файл",
  "storage": "local",
  "fields": [
    {
      "id": "credentials",
      "label": "JSON service account",
      "kind": "json",
      "required": true,
      "max_bytes": 65536
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "file",
      "field": "credentials",
      "target": "/run/mcp-secrets/service-account.json",
      "env_name": "GOOGLE_APPLICATION_CREDENTIALS"
    }
  ]
}
