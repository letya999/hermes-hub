{
  "id": "github-app-files",
  "revision": 1,
  "title": "GitHub App: parameters and key",
  "storage": "local",
  "fields": [
    {
      "id": "app_id",
      "label": "App ID",
      "kind": "string",
      "required": true,
      "max_bytes": 128,
      "label_i18n": {
        "ru": "ID приложения",
        "kk": "Қолданба ID-сі",
        "es": "ID de la app"
      }
    },
    {
      "id": "installation_id",
      "label": "Installation ID",
      "kind": "string",
      "required": true,
      "max_bytes": 128,
      "label_i18n": {
        "ru": "ID установки",
        "kk": "Орнату ID-сі",
        "es": "ID de instalación"
      }
    },
    {
      "id": "private_key",
      "label": "PEM private key",
      "kind": "pem",
      "required": true,
      "max_bytes": 16384,
      "label_i18n": {
        "ru": "Закрытый PEM-ключ",
        "kk": "PEM жеке кілті",
        "es": "Clave privada PEM"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "env",
      "field": "app_id",
      "target": "GITHUB_APP_ID"
    },
    {
      "type": "env",
      "field": "installation_id",
      "target": "GITHUB_INSTALLATION_ID"
    },
    {
      "type": "file",
      "field": "private_key",
      "target": "/run/mcp-secrets/github-app.pem",
      "env_name": "GITHUB_APP_PRIVATE_KEY_FILE"
    }
  ],
  "title_i18n": {
    "ru": "GitHub App: параметры и ключ",
    "kk": "GitHub App: параметрлер және кілт",
    "es": "GitHub App: parámetros y clave"
  }
}
