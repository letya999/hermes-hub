{
  "id": "basic-json-file",
  "revision": 1,
  "title": "Two fields in one JSON",
  "storage": "local",
  "fields": [
    {
      "id": "username",
      "label": "Username",
      "kind": "string",
      "required": true,
      "max_bytes": 256,
      "label_i18n": {
        "ru": "Имя пользователя",
        "kk": "Пайдаланушы аты",
        "es": "Nombre de usuario"
      }
    },
    {
      "id": "password",
      "label": "Password",
      "kind": "secret",
      "required": true,
      "max_bytes": 4096,
      "label_i18n": {
        "ru": "Пароль",
        "kk": "Құпиясөз",
        "es": "Contraseña"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "json_file",
      "target": "/run/mcp-secrets/login.json",
      "mapping": {
        "username": "username",
        "password": "password"
      }
    }
  ],
  "title_i18n": {
    "ru": "Два поля в одном JSON",
    "kk": "Бір JSON-дағы екі өріс",
    "es": "Dos campos en un JSON"
  }
}
