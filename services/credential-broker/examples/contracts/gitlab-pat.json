{
  "id": "gitlab-pat",
  "revision": 1,
  "title": "GitLab PAT",
  "storage": "local",
  "fields": [
    {
      "id": "token",
      "label": "GitLab personal access token",
      "kind": "secret",
      "required": true,
      "max_bytes": 4096,
      "label_i18n": {
        "ru": "Персональный токен доступа GitLab",
        "kk": "GitLab жеке қол жеткізу токені",
        "es": "Token de acceso personal de GitLab"
      }
    },
    {
      "id": "api_url",
      "label": "GitLab API URL (self-hosted, optional)",
      "kind": "string",
      "required": false,
      "max_bytes": 2048,
      "label_i18n": {
        "ru": "URL API GitLab (self-hosted, необязательно)",
        "kk": "GitLab API URL (self-hosted, міндетті емес)",
        "es": "URL de la API de GitLab (autoalojado, opcional)"
      }
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "env",
      "field": "token",
      "target": "GITLAB_PERSONAL_ACCESS_TOKEN"
    },
    {
      "type": "env",
      "field": "token",
      "target": "GITLAB_TOKEN"
    },
    {
      "type": "env",
      "field": "api_url",
      "target": "GITLAB_API_URL"
    }
  ],
  "title_i18n": {
    "ru": "GitLab: персональный токен",
    "kk": "GitLab: жеке токен",
    "es": "GitLab: token personal"
  }
}
