[Unit]
Description=Hermes Credential Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=credential-broker
Group=credential-broker
ExecStart=/usr/local/bin/credential-broker serve --config /var/lib/credential-broker/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
StateDirectory=credential-broker
StateDirectoryMode=0700
RuntimeDirectory=credential-broker
RuntimeDirectoryMode=0700
# Broker validates the actual runtime filesystem is tmpfs; configure the host accordingly.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
TasksMax=128
MemoryMax=512M
ReadWritePaths=/var/lib/credential-broker /run/credential-broker

[Install]
WantedBy=multi-user.target
