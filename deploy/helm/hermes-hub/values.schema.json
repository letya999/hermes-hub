{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["services", "persistence", "runtimeImage", "environment"],
  "properties": {
    "runtimeClassName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "runtimeImage": {"type": "string", "minLength": 1},
    "environment": {"enum": ["dev", "prod"]},
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["backend", "kubernetes"],
      "properties": {
        "backend": {"enum": ["docker", "kubernetes"]},
        "kubernetes": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
            "runtimeClassName": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
            "storageClass": {"type": "string"}, "storageSize": {"type": "string", "minLength": 1},
            "apiServerCIDRs": {"type": "array", "items": {"type": "string", "minLength": 3}},
            "apiServerPorts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
          }
        }
      }
    },
    "services": {
      "type": "object", "additionalProperties": false,
      "required": ["communication-hub", "supervisor", "toolhub", "credential-broker", "cliproxy"],
      "properties": {
        "communication-hub": {"allOf": [{"$ref": "#/definitions/service"}, {"properties": {"port": {"const": 8081}}}]},
        "supervisor": {"allOf": [{"$ref": "#/definitions/service"}, {"properties": {"port": {"const": 8876}}}]},
        "toolhub": {"allOf": [{"$ref": "#/definitions/service"}, {"properties": {"port": {"const": 8090}}}]},
        "credential-broker": {"allOf": [{"$ref": "#/definitions/service"}, {"properties": {"port": {"const": 8787}}}]},
        "cliproxy": {"allOf": [{"$ref": "#/definitions/service"}, {"properties": {"port": {"const": 8317}}}]}
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": {"$ref": "#/definitions/claim"},
      "required": ["spaces", "spool", "broker", "brokerRecovery", "cliproxy"]
    },
    "externalSecrets": {
      "type": "array", "items": {
        "type": "object", "required": ["name", "secretStoreRef", "data"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "refreshInterval": {"type": "string"},
          "secretStoreRef": {
            "type": "object", "required": ["name", "kind"], "additionalProperties": false,
            "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["SecretStore", "ClusterSecretStore"]}}
          },
          "data": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["secretKey", "remoteRef"]}}
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1},
        "gatewayPaths": {"type": "array", "items": {"type": "string", "pattern": "^/(credentials/|skill-drafts/|iam/)"}},
        "toolhubPaths": {"type": "array", "items": {"type": "string", "pattern": "^/(credentials/|connect/|confirm/|remove/|oauth/callback$|knowledge/)"}}
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "credentials": {"type": "object", "required": ["communication-hub", "supervisor"], "additionalProperties": {"$ref": "#/definitions/secretRef"}}
      }
    }
  },
  "definitions": {
    "envName": {
      "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$",
      "not": {"enum": ["HOME", "HUB_ENVIRONMENT", "HUB_RUNTIME_SUPERVISOR_URL", "HUB_TOOLHUB_URL", "HUB_COMMUNICATION_CONTROL_URL", "HUB_TOOLHUB_URL_PATTERN", "HUB_EXECUTION_BACKEND", "HUB_KUBERNETES_NAMESPACE", "HUB_KUBERNETES_CONTROL_NAMESPACE", "HUB_KUBERNETES_CONTROL_RELEASE", "HUB_RUNTIME_CLASS_NAME", "HUB_KUBERNETES_STORAGE_CLASS", "HUB_KUBERNETES_STORAGE_SIZE", "HUB_KUBERNETES_PULL_SECRETS", "HUB_KUBERNETES_RELAY_IMAGE", "HUB_KUBERNETES_TOOLHUB_URL", "HUB_KUBERNETES_CLIPROXY_URL"]}
    },
    "secretRef": {
      "type": "object", "additionalProperties": false, "required": ["name", "key"],
      "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["size", "accessModes", "existingClaim"],
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]}},
        "storageClass": {"type": ["string", "null"]}, "existingClaim": {"type": "string"}
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "command", "args", "port", "configSecret", "env", "secretEnv", "mounts", "resources"],
      "properties": {
        "image": {
          "type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "args": {"type": "array", "items": {"type": "string"}},
        "port": {"type": "integer"}, "configSecret": {"type": "string"},
        "configItems": {"type": "array", "items": {"type": "object", "required": ["key", "path"], "properties": {"key": {"type": "string"}, "path": {"type": "string", "pattern": "^[^./][^\\\\]*$"}}}},
        "env": {"type": "object", "propertyNames": {"$ref": "#/definitions/envName"}, "additionalProperties": {"type": "string"}},
        "secretEnv": {"type": "object", "propertyNames": {"$ref": "#/definitions/envName"}, "additionalProperties": {"$ref": "#/definitions/secretRef"}},
        "mounts": {"type": "array", "items": {
          "type": "object", "required": ["claim", "path"], "additionalProperties": false,
          "properties": {"claim": {"enum": ["spaces", "spool", "broker", "brokerRecovery", "cliproxy"]}, "path": {"type": "string", "pattern": "^/"}, "readOnly": {"type": "boolean"}}
        }},
        "resources": {"type": "object"}
      }
    }
  }
}
