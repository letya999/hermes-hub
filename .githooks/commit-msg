#!/bin/sh
set -eu

message_file=$1
first_line=$(sed -n '1p' "$message_file")
case "$first_line" in
	Merge\ *|Revert\ \"*) ;;
	*)
		if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|chore|docs|test|refactor|perf|build|ci|revert|hotfix)(\([a-z0-9._/-]+\))?!?: .+'; then
			echo "Commit message must use Conventional Commits, e.g. feat(scope): short description." >&2
			exit 1
		fi
		;;
esac
if grep -Eiq '^[[:space:]]*co-authored-by:' "$message_file"; then
	echo "Co-authors are forbidden; use only the global human Git identity." >&2
	exit 1
fi
