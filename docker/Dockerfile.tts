# syntax=docker/dockerfile:1
# Standalone TTS service (hub-tts). Dedicated image, deliberately thin: the
# default `command` engine needs only espeak-ng + ffmpeg, no ML stack.
# `remote` proxies to any OpenAI-compatible TTS upstream (Speaches
# piper/kokoro, OpenAI, bespoke model servers); `sherpa` needs the
# -tags sherpa build with the native library.
FROM golang:1.27-bookworm@sha256:a58ef1bdf40835a04cca75896cfb8f9e3ee10a6d264dd91d91e4497cc34e75f7 AS go_build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod go mod download
COPY cmd/hub-tts ./cmd/hub-tts
COPY internal/mediasvc ./internal/mediasvc
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod --mount=type=cache,id=hermes-go-build,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o /hub-tts ./cmd/hub-tts

FROM python:3.13-slim-trixie@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=go_build /hub-tts /usr/local/bin/hub-tts
COPY docker/media/tts-worker /usr/local/bin/
RUN chmod 0755 /usr/local/bin/tts-worker
RUN useradd -r -u 10003 -m tts && mkdir -p /data && chown 10003:10003 /data
USER 10003:10003
ENTRYPOINT ["hub-tts"]
