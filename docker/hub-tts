#!/usr/local/bin/python3
"""Hub-owned TTS worker for communication-hub CommandSynthesizer.

Reads reply text on stdin, writes OGG/Opus audio on stdout: espeak-ng renders
speech to a wav, system ffmpeg encodes it to the ogg container Telegram
sendVoice expects. No network, no model downloads. Language via HUB_TTS_LANG
(default "ru"); a voice variant can ride HUB_TTS_VOICE (default "+f3").
"""
import os
import subprocess
import sys
import tempfile


def main() -> int:
    text = sys.stdin.read().strip()
    if not text:
        return 1
    lang = os.environ.get("HUB_TTS_LANG", "ru")
    variant = os.environ.get("HUB_TTS_VOICE", "+f3")
    voice = lang + variant
    with tempfile.TemporaryDirectory() as tmp:
        wav = os.path.join(tmp, "voice.wav")
        ogg = os.path.join(tmp, "voice.ogg")
        render = subprocess.run(
            ["espeak-ng", "-v", voice, "-s", "150", "--stdin", "-w", wav],
            input=text.encode(), capture_output=True, timeout=25)
        if render.returncode != 0 or not os.path.exists(wav):
            return 1
        encode = subprocess.run(
            ["ffmpeg", "-nostdin", "-y", "-i", wav, "-c:a", "libopus", "-b:a", "32k", ogg],
            capture_output=True, timeout=25)
        if encode.returncode != 0 or not os.path.exists(ogg):
            return 1
        sys.stdout.buffer.write(open(ogg, "rb").read())
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, subprocess.SubprocessError):
        raise SystemExit(1)
