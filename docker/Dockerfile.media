# syntax=docker/dockerfile:1
# Standalone speech services: one binary, two roles (HUB_MEDIA_ROLE=stt|tts).
# The gateway image stays thin; model work lives and scales here. Default
# engine is `command` (hub-stt/hub-tts wrappers below); `remote` proxies to any
# OpenAI-compatible model server and `sherpa` needs the -tags sherpa build.
FROM golang:1.27-bookworm@sha256:a58ef1bdf40835a04cca75896cfb8f9e3ee10a6d264dd91d91e4497cc34e75f7 AS go_build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod go mod download
COPY cmd/hub-media ./cmd/hub-media
COPY internal/mediasvc ./internal/mediasvc
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod --mount=type=cache,id=hermes-go-build,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o /hub-media ./cmd/hub-media

FROM python:3.13-slim-trixie@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng ca-certificates && rm -rf /var/lib/apt/lists/*
# faster-whisper alone: the command STT engine; no messaging/voice extras.
RUN pip install --no-cache-dir faster-whisper==1.2.1
COPY --from=go_build /hub-media /usr/local/bin/hub-media
COPY docker/media/hub-stt docker/media/hub-tts /usr/local/bin/
RUN chmod 0755 /usr/local/bin/hub-stt /usr/local/bin/hub-tts
RUN useradd -r -u 10002 -m media && mkdir -p /data && chown 10002:10002 /data
USER 10002:10002
ENTRYPOINT ["hub-media"]
