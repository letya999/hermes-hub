# syntax=docker/dockerfile:1
# Standalone STT service (hub-stt). Dedicated image: STT scales, restarts and
# carries its own model toolchain separately from hub-tts. Default engine is
# `command` (stt-worker → faster-whisper); `remote` proxies to any
# OpenAI-compatible upstream (Groq, Speaches, whisperx, NVIDIA NIM via
# gateway); `sherpa` needs the -tags sherpa build with the native library.
FROM golang:1.27.2-bookworm AS go_build
WORKDIR /src
COPY go.mod go.sum ./
COPY services/credential-broker ./services/credential-broker
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod go mod download
COPY cmd/hub-stt ./cmd/hub-stt
COPY internal/mediasvc ./internal/mediasvc
COPY internal/credentialbroker ./internal/credentialbroker
COPY internal/identity ./internal/identity
RUN --mount=type=cache,id=hermes-go-mod,target=/go/pkg/mod --mount=type=cache,id=hermes-go-build,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o /hub-stt ./cmd/hub-stt

FROM python:3.13-slim-trixie@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0 AS stt
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
# faster-whisper alone: the command STT engine; no messaging/voice extras.
RUN for i in 1 2 3 4; do if pip install --no-cache-dir faster-whisper==1.2.1; then break; fi; if [ "$i" = 4 ]; then exit 1; fi; sleep 10; done
COPY --from=go_build /hub-stt /usr/local/bin/hub-stt
COPY docker/media/stt-worker /usr/local/bin/
RUN chmod 0755 /usr/local/bin/stt-worker
RUN useradd -r -u 10001 -m stt && mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
ENTRYPOINT ["hub-stt"]
