    ]},
    "contract_id": "txttsql-sql", "contract_revision": 1, "stateful": false,
    "tcp_forwards": [
      {"listen": 15432, "target_env": "TXTTSQL_ENDPOINT"},
      {"listen": 15433, "target_env": "TXTTSQL_ENDPOINT_2"},
      {"listen": 15434, "target_env": "TXTTSQL_ENDPOINT_3"}
    ],
    "egress": ["127.0.0.1"], "read_tools": ["list_sources", "list_tables", "describe_table", "validate_sql", "execute_sql"],
