      {"name": "TXTTSQL_ENDPOINT", "type": "string", "required": true, "secret": false, "delivery": "env", "target": "TXTTSQL_ENDPOINT"},
      {"name": "TXTTSQL_ENDPOINT_2", "type": "string", "required": false, "secret": false, "delivery": "env", "target": "TXTTSQL_ENDPOINT_2"},
      {"name": "TXTTSQL_ENDPOINT_3", "type": "string", "required": false, "secret": false, "delivery": "env", "target": "TXTTSQL_ENDPOINT_3"},
      {"name": "TXTTSQL_PASSWORD_1", "type": "token", "required": false, "secret": true, "delivery": "env", "target": "TXTTSQL_PASSWORD_1"},
      {"name": "TXTTSQL_PASSWORD_2", "type": "token", "required": false, "secret": true, "delivery": "env", "target": "TXTTSQL_PASSWORD_2"},
      {"name": "TXTTSQL_PASSWORD_3", "type": "token", "required": false, "secret": true, "delivery": "env", "target": "TXTTSQL_PASSWORD_3"},
      {"name": "TXTTSQL_CONFIG", "type": "file", "required": false, "secret": true, "delivery": "file", "target": "/app/config.toml"},
