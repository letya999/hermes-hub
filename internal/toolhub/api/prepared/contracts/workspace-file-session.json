{
  "id": "workspace-file-session",
  "revision": 1,
  "title": "Workspace: OAuth client and account session",
  "title_i18n": {
    "ru": "Workspace: OAuth-клиент и сессия аккаунта",
    "kk": "Workspace: OAuth клиенті және аккаунт сессиясы",
    "es": "Workspace: cliente OAuth y sesión de cuenta"
  },
  "storage": "local",
  "allow_shared": false,
  "fields": [
    {
      "id": "client_json",
      "label": "OAuth client JSON",
      "label_i18n": {
        "ru": "JSON OAuth-клиента",
        "kk": "OAuth клиенті JSON",
        "es": "JSON de cliente OAuth"
      },
      "kind": "json",
      "required": true,
      "max_bytes": 65536
    },
    {
      "id": "account_email",
      "label": "Google account email",
      "label_i18n": {
        "ru": "Email аккаунта Google",
        "kk": "Google аккаунтының email-і",
        "es": "Correo de la cuenta de Google"
      },
      "kind": "string",
      "required": true,
      "max_bytes": 320
    }
  ],
  "deliveries": [
    {
      "type": "file",
      "field": "client_json",
      "target": "/run/mcp-secrets/client.json",
      "env_name": "GOOGLE_CLIENT_SECRET_PATH"
    },
    {
      "type": "env",
      "field": "account_email",
      "target": "USER_GOOGLE_EMAIL"
    }
  ],
  "state": {
    "target": "/home/mcp/.google_workspace_mcp/credentials",
    "files": [
      {
        "name": "runtime_session.json",
        "max_bytes": 65536,
        "json": true
      }
    ]
  }
}
