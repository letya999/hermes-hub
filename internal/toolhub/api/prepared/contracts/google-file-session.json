{
  "id": "google-file-session",
  "revision": 2,
  "title": "Google: OAuth client JSON and authorization state",
  "title_i18n": {
    "ru": "Google: JSON и состояние авторизации",
    "kk": "Google: OAuth клиенті JSON және авторизация күйі",
    "es": "Google: JSON de cliente OAuth y estado de autorización"
  },
  "storage": "local",
  "fields": [
    {
      "id": "client_json",
      "label": "OAuth client JSON",
      "label_i18n": {
        "ru": "JSON OAuth-клиента",
        "kk": "OAuth клиенті JSON",
        "es": "JSON de cliente OAuth"
      },
      "kind": "json",
      "required": true,
      "max_bytes": 65536
    }
  ],
  "allow_shared": false,
  "deliveries": [
    {
      "type": "file",
      "field": "client_json",
      "target": "/run/mcp-secrets/google/client.json",
      "env_name": "GOOGLE_OAUTH_CREDENTIALS"
    }
  ],
  "state": {
    "target": "/home/mcp/.config/google-calendar",
    "files": [
      {
        "name": "runtime_session.json",
        "max_bytes": 65536,
        "json": true
      }
    ]
  }
}
